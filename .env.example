# Copy this file to .env and fill in the values. Never commit .env.

# --- Required ---------------------------------------------------------------
# Google Gemini: agents, chat, embeddings, text-to-speech (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# MongoDB connection string (MongoDB Atlas free tier works)
MONGODB_URI=

# --- Recommended ------------------------------------------------------------
# Password-protects the app. Set it before deploying anywhere public.
APP_PASSWORD=
# Speech-to-text with speaker labels, needed for audio/video recordings (https://www.assemblyai.com)
ASSEMBLYAI_API_KEY=

# --- Chat search (optional) ---------------------------------------------------
# Qdrant URL (Qdrant Cloud), or a folder path such as ./qdrant_data for a local store. Empty = keyword search.
QDRANT_URI=
QDRANT_API_KEY=

# --- Email (optional) ---------------------------------------------------------
# SMTP, e.g. Gmail with an app password (https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Or Composio's Gmail integration (connect Gmail in the Composio dashboard first)
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
# smtp, composio, or empty to pick whichever is configured (SMTP first)
EMAIL_PROVIDER=

# --- Tuning (optional) ----------------------------------------------------------
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=
# GEMINI_REQUESTS_PER_MINUTE=
# MONGODB_DB_NAME=meeting_minutes
# QDRANT_COLLECTION=meeting_chunks

# Turn off CrewAI's anonymous usage telemetry
OTEL_SDK_DISABLED=true
